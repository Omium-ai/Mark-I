{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omium.ai/mark1/appapi/team.json",
  "title": "GET /api/v1/team",
  "description": "Team v1 (15-teams, 16-release L3): the owner row, active members and live invites, the caller's role, the shared-memory flag, the tenant's 30d TVO summary (aggregate; null when the report refuses), per-member 30d totals (aggregates only, never a session or a device; null when the ledger read fails), and placeholders that are null until their feature lands.",
  "type": "object",
  "required": [
    "members",
    "you",
    "max_members",
    "invite_link",
    "shared_memory",
    "tvo",
    "totals",
    "fleet_status"
  ],
  "additionalProperties": false,
  "properties": {
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "role",
          "joined_at",
          "last_active",
          "status",
          "totals"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "GET /me user.id for a member (the token sub), or invite:<uuid>"
          },
          "name": {
            "type": "null",
            "description": "no users table: null until one lands"
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "description": "the address from the member's user token at accept (owner: at their last read/invite), or the invited address; null when none"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "member"
            ]
          },
          "joined_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_active": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "latest device heartbeat of that member in this tenant; null for invites and members with no device yet"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "invited"
            ]
          },
          "totals": {
            "$ref": "#/$defs/member_totals",
            "description": "this member's 30d totals; null for an invite or when the ledger read failed"
          }
        }
      }
    },
    "max_members": {
      "type": "integer",
      "minimum": 1,
      "description": "TEAM_MAX_MEMBERS: owner + members + live invites"
    },
    "you": {
      "type": "object",
      "required": [
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "owner",
            "member"
          ]
        }
      }
    },
    "invite_link": {
      "type": "null",
      "description": "the raw token is answered once by POST /team/invites; m1_081 keeps only its hash"
    },
    "shared_memory": {
      "type": "boolean"
    },
    "tvo": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "tvo",
        "coverage_band",
        "cost_basis",
        "guarantee_grade"
      ],
      "additionalProperties": false,
      "properties": {
        "tvo": {
          "type": [
            "number",
            "null"
          ]
        },
        "coverage_band": {
          "$ref": "honesty.json#/properties/coverage_band"
        },
        "cost_basis": {
          "type": "string",
          "enum": [
            "usd",
            "quota"
          ]
        },
        "guarantee_grade": {
          "type": "boolean"
        },
        "refusal": {
          "type": "string"
        },
        "trend": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "day",
              "tvo"
            ],
            "properties": {
              "day": {
                "type": "string"
              },
              "tvo": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "totals": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "window",
        "team",
        "unattributed"
      ],
      "additionalProperties": false,
      "properties": {
        "window": {
          "type": "object",
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string",
              "format": "date"
            },
            "to": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "team": {
          "$ref": "#/$defs/totals"
        },
        "unattributed": {
          "$ref": "#/$defs/totals",
          "description": "work on devices of no listed member (a leaver's, an unenrolled one)"
        }
      }
    },
    "fleet_status": {
      "type": "null",
      "description": "enterprise fleet/gateway status: null until it exists"
    }
  },
  "$defs": {
    "totals": {
      "type": "object",
      "required": [
        "sessions",
        "tasks_verified",
        "tokens",
        "tokens_saved"
      ],
      "additionalProperties": false,
      "properties": {
        "sessions": {
          "type": "integer",
          "minimum": 0
        },
        "tasks_verified": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_saved": {
          "type": "integer",
          "description": "estimated tokens saved (the savings chip's own measure); may be negative once the net estimate lands"
        }
      }
    },
    "member_totals": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "sessions",
        "tasks_verified",
        "tokens",
        "tokens_saved"
      ],
      "additionalProperties": false,
      "properties": {
        "sessions": {
          "type": "integer",
          "minimum": 0
        },
        "tasks_verified": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_saved": {
          "type": "integer",
          "description": "estimated tokens saved (the savings chip's own measure); may be negative once the net estimate lands"
        }
      }
    }
  }
}
