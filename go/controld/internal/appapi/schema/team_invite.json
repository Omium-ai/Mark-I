{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omium.ai/mark1/appapi/team_invite.json",
  "title": "POST /api/v1/team/invites",
  "description": "A minted invite (m1_081): the link carries the raw token exactly once; nothing is emailed in v1.",
  "type": "object",
  "required": ["sent", "invite_link", "invited_email", "status", "expires_at"],
  "additionalProperties": false,
  "properties": {
    "sent": { "type": "boolean", "enum": [true] },
    "invite_link": { "type": "string", "pattern": "^https://app\\.omium\\.ai/invite/[0-9a-f-]{36}/[A-Za-z0-9_-]{43}$" },
    "invited_email": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["sent"] },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
