{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omium.ai/mark1/app-v0.1.14/team.json",
  "description": "Mark1-GUI v0.1.14 Team + TeamMember + TeamTvo (trend points are TrendPoint: tvo a number).",
  "type": "object",
  "required": ["members", "invite_link", "shared_memory", "tvo", "fleet_status"],
  "properties": {
    "max_members": { "type": "integer", "minimum": 1 },
    "members": { "type": "array", "items": { "type": "object", "required": ["id", "name", "email", "role"], "properties": {
      "id": { "type": "string" }, "name": { "type": ["string", "null"] }, "email": { "type": ["string", "null"] }, "role": { "type": "string" },
      "joined_at": { "type": "string" }, "last_active": { "type": ["string", "null"] }, "status": { "type": "string", "enum": ["active", "invited", "paused"] } } } },
    "you": { "type": "object", "required": ["role"], "properties": { "role": { "type": "string", "enum": ["owner", "member"] } } },
    "invite_link": { "type": ["string", "null"] },
    "shared_memory": { "type": "boolean" },
    "tvo": { "type": ["object", "null"], "required": ["tvo", "coverage_band", "cost_basis", "guarantee_grade"], "properties": {
      "tvo": { "type": ["number", "null"] },
      "coverage_band": { "type": "object", "required": ["observed_fraction", "floor"], "properties": { "observed_fraction": { "type": "number" }, "floor": { "type": "number" } } },
      "cost_basis": { "type": "string", "enum": ["usd", "quota"] }, "guarantee_grade": { "type": "boolean" },
      "trend": { "type": "array", "items": { "$ref": "tvo_report.json#/$defs/trend_point" } },
      "refusal": { "type": ["string", "object", "null"] } } }
  }
}
